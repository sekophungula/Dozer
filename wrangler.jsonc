// Dozex website: built into website/public by website/build.py, served by Cloudflare at dozer.shakatec.co.za.
// Deploy: python3 website/build.py && npx -y wrangler@4.166.0 deploy
{
  "name": "dozex-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./website/public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dozer.shakatec.co.za", "custom_domain": true }
  ]
}
